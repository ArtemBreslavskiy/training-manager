<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TrainingManager.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TrainingManager.Views.WelcomePageView"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*,Auto" HorizontalAlignment="Center">
		<TextBox Grid.Row="0" Watermark="Search..." FontSize="16" Width="500" Text="{Binding SearchedName}" Margin="20 20 20 40"></TextBox>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center">
			<ItemsControl ItemsSource="{Binding TrainingProgramViewModels}">

                <ItemsControl.ItemContainerTheme>
                    <ControlTheme TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="15"></Setter>
                    </ControlTheme>
                </ItemsControl.ItemContainerTheme>

	            <ItemsControl.ItemsPanel>
		            <ItemsPanelTemplate>
			            <WrapPanel></WrapPanel>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
		            <DataTemplate>
			            <Border Padding="20" Margin="20" BorderThickness="2" BorderBrush="Gray" CornerRadius="4">
							<Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
								<TextBox Grid.Column="0" Text="{Binding InputProgramName}" Watermark="Untitled" FontSize="20" Margin="0 0 20 0" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="0"></TextBox>

                                <Button Grid.Column="1" Content="Go" Background="#3E5F8A" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="50"
                                    Command="{Binding DataContext.GoTodaySessionPageCommand,
                                    RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding TrainingProgram.Id}">
                                </Button>

                                <Button Grid.Column="2" Content="Edit" Background="#CC5500" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="70" 
                                    Command="{Binding DataContext.GoSelectedTrainingProgramPageCommand,
                                    RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding TrainingProgram.Id}">
                                </Button>

                                <Button Grid.Column="3" Content="Delete" Background="#B00000" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="80"
                                    Command="{Binding DataContext.DeleteProgramCommand,
                                    RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding TrainingProgram.Id}">
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20" Spacing="10">
            <TextBox Watermark="Name" Width="160" Height="32" Text="{Binding InputName}"></TextBox>
            <TextBox Watermark="Days" Width="70" Height="32" Text="{Binding InputDaysCount}"></TextBox>
            <Button Content="Create" Background="#008000" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="80" 
                Command="{Binding CreateProgramCommand}"></Button>
        </StackPanel>
    </Grid>

</UserControl>

